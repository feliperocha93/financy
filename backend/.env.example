# JWT secret used to sign and verify auth tokens. Use a long, random string in production.
# Default below is for local development only.
JWT_SECRET=supersecretkey123

# PostgreSQL connection string. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Defaults match docker-compose (user: postgres, password: password, db: financy, host port: 5433).
DATABASE_URL="postgresql://postgres:password@localhost:5433/financy?schema=public"
